<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · LinePilot MES</title>
    <meta name="description" content="LinePilot: a manufacturing execution system demo built by Aoun Raza with ASP.NET Core MVC and Entity Framework Core." />
    <meta name="author" content="Aoun Raza" />
    <link rel="icon" type="image/svg+xml" href="~/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    @{
        var controller = ViewContext.RouteData.Values["controller"]?.ToString();
        string Active(string name) => controller == name ? "active" : "";
    }
    <nav class="navbar navbar-expand-md navbar-dark lp-nav">
        <div class="container-xl">
            <a class="navbar-brand lp-brand" asp-controller="Home" asp-action="Index">
                <span class="lp-brand__mark" aria-hidden="true">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M3 21V10l5 3V10l5 3V6l8 4v11z" /></svg>
                </span>
                LinePilot <span class="lp-brand__tag">MES</span>
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"
                    aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="mainNav">
                <ul class="navbar-nav ms-md-4 me-auto">
                    <li class="nav-item"><a class="nav-link @Active("Home")" asp-controller="Home" asp-action="Index">Dashboard</a></li>
                    <li class="nav-item"><a class="nav-link @Active("WorkOrders")" asp-controller="WorkOrders" asp-action="Index">Work orders</a></li>
                    <li class="nav-item"><a class="nav-link @Active("Machines")" asp-controller="Machines" asp-action="Index">Machines</a></li>
                    <li class="nav-item"><a class="nav-link @Active("Inventory")" asp-controller="Inventory" asp-action="Index">Inventory</a></li>
                </ul>
                <span class="lp-demo">Demo plant · sample data</span>
            </div>
        </div>
    </nav>

    <main class="container-xl lp-main" role="main">
        <partial name="_Flash" />
        @RenderBody()
    </main>

    <footer class="lp-footer">
        <div class="container-xl">
            Designed &amp; Built by <a href="https://github.com/aoun02" target="_blank" rel="noreferrer">Aoun Raza</a>
            <span class="text-muted"> · ASP.NET Core MVC · EF Core · Hosted on Vercel</span>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
