@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}
<div class="lp-empty">
    <h1>Something went wrong</h1>
    <p class="text-muted">The request could not be completed. Please go back and try again.</p>
    @if (Model?.ShowRequestId == true)
    {
        <p class="small text-muted">Request ID: <code>@Model.RequestId</code></p>
    }
    <a class="btn lp-btn" asp-controller="Home" asp-action="Index">Back to dashboard</a>
</div>
